# Copy to .env and enter your own credentials. Never commit .env.
DEEPSEEK_API_KEY=
# OpenAI-compatible endpoint supplied by your model provider.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# Model names are configured in configs/*.json; default: deepseek-flash.
# For another provider set api_base_url and api_key_env in the JSON config,
# and add that provider's key as an environment variable. Never put a key in JSON.
